APP_NAME=go-api
APP_ENV=dev
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=30
GRPC_AI_TARGET=127.0.0.1:50051
AI_GRPC_PING_TIMEOUT_SECONDS=2
MYSQL_DSN=oncall:oncall@tcp(127.0.0.1:3306)/oncall?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_PING_TIMEOUT_SECONDS=2
REDIS_ADDR=127.0.0.1:6379
REDIS_PING_TIMEOUT_SECONDS=2
